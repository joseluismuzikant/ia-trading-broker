# ---------------------------------------------------------------------------
# ia-trading-broker - example environment file (Day 3)
#
# Copy this file to `.env` and change every placeholder before use:
#
#     cp .env.example .env
#
# `.env` is git-ignored. Never commit real passwords, tokens, or keys.
# ---------------------------------------------------------------------------

# --- Application -----------------------------------------------------------
APP_NAME=ia-trading-broker
# development | production
ENVIRONMENT=development

# --- Security --------------------------------------------------------------
# Long, random value. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-me-with-a-long-random-value-at-least-16-chars

# Name of the login cookie. Change it if you run more than one instance behind
# the same host.
SESSION_COOKIE_NAME=iatb_session

# How long a login lasts, in hours.
SESSION_TTL_HOURS=72

# Send the cookie only over HTTPS. Must be true in production.
COOKIE_SECURE=false

# Fernet key that encrypts saved IOL passwords. Generate your own with:
#   python -c "import base64,os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
# Changing or losing this key makes every saved connection unusable: the stored
# passwords are encrypted with it and cannot be recovered.
CREDENTIAL_ENCRYPTION_KEY=replace-me-with-a-generated-fernet-key

# --- IOL broker ------------------------------------------------------------
# Base URL of the IOL REST API. Keep HTTPS for anything that is not local.
IOL_BASE_URL=https://api.invertironline.com

# Timeout, in seconds, for a single IOL request.
IOL_REQUEST_TIMEOUT_SECONDS=15

# IOL is free up to a monthly quota and bills for every call past it, so the
# app counts its own calls and refuses to exceed the limit. Set 0 to remove the
# cap and accept the cost.
IOL_MONTHLY_CALL_LIMIT=25000

# Fraction of the limit at which a single warning is logged.
IOL_CALL_WARN_RATIO=0.8


# --- Analysis models (optional) ------------------------------------------
# A run picks its model from config/models.toml. Each entry names the provider
# key it needs, so only the entries you use have to be set. Leaving them empty
# is fine for the application and the tests; a run that needs a missing key
# stops with a clear error and saves no proposal. Never commit a real key.
OPENAI_API_KEY=
GEMINI_API_KEY=
MIMO_API_KEY=
DEEPSEEK_API_KEY=
XAI_API_KEY=
ANTHROPIC_API_KEY=
# Seconds to wait for one model call, whichever provider answers. Positive.
OPENAI_TIMEOUT_SECONDS=30
# Catalog key the run form preselects. Empty uses config/models.toml's default.
ANALYSIS_MODEL_DEFAULT=
# Where the model catalog lives. Empty uses the shipped config/models.toml.
MODELS_CONFIG_PATH=

# --- Database --------------------------------------------------------------
# Used when you run the app or the tests directly on your machine.
DATABASE_URL=postgresql+asyncpg://trading:change-me-in-production@localhost:5432/trading

# Used by the PostgreSQL container in docker-compose.yml.
POSTGRES_USER=trading
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_DB=trading

# --- Live IOL execution parameters (real orders need both) -----------------
# Approved trades are sent to IOL with REAL money, one trade at a time, on your
# command. Leaving these unset is what keeps live execution off: it fails
# closed instead of inventing a trading parameter.
# Settlement term IOL requires on every trading order (for example "t2").
IOL_LIVE_PLAZO=
# How many days an order stays valid (sent to IOL as its ``validez`` date).
# 0 means "not configured" and live execution fails closed.
IOL_LIVE_VALIDITY_DAYS=0

APPROVAL_EXECUTION_WINDOW_HOURS=24

# --- PPI broker (optional; work in progress, not yet selectable in the UI) --
# PPI issues AuthorizedClient and ClientKey to the integration. Each user's own
# public and private API keys are stored with their connection, not here.
# The sandbox is the default; production needs an explicit decision.
PPI_BASE_URL=https://clientapi_sandbox.portfoliopersonal.com
PPI_AUTHORIZED_CLIENT=
PPI_CLIENT_KEY=
# Live PPI orders fail closed until both are set (see the PPI notes in the README).
PPI_LIVE_SETTLEMENT=
PPI_LIVE_OPERATION_TERM=

# --- LangSmith tracing (optional) ----------------------------------------
# Tracing is off by default and the application runs the same without it.
# Set LANGSMITH_TRACING=true and provide a key to see the LangGraph nodes and
# the portfolio-analysis call in your LangSmith project. Secrets are never
# traced. Tests run without any LangSmith network call.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=ia-trading-broker
# Optional: a self-hosted or regional LangSmith endpoint and workspace.
LANGSMITH_ENDPOINT=
LANGSMITH_WORKSPACE_ID=
