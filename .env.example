# ---------------------------------------------------------------------------
# ia-trading-broker - example environment file (Day 1)
#
# Copy this file to `.env` and change every placeholder before use:
#
#     cp .env.example .env
#
# `.env` is git-ignored. Never commit real passwords, tokens, or keys.
# ---------------------------------------------------------------------------

# --- Application -----------------------------------------------------------
APP_NAME=ia-trading-broker
# development | production
ENVIRONMENT=development

# --- Security --------------------------------------------------------------
# Long, random value. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-me-with-a-long-random-value-at-least-16-chars

# Name of the login cookie. Change it if you run more than one instance behind
# the same host.
SESSION_COOKIE_NAME=iatb_session

# How long a login lasts, in hours.
SESSION_TTL_HOURS=72

# Send the cookie only over HTTPS. Must be true in production.
COOKIE_SECURE=false

# --- Database --------------------------------------------------------------
# Used when you run the app or the tests directly on your machine.
DATABASE_URL=postgresql+asyncpg://trading:change-me-in-production@localhost:5432/trading

# Used by the PostgreSQL container in docker-compose.yml.
POSTGRES_USER=trading
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_DB=trading

# --- Trading safety switches ----------------------------------------------
# Live order handling is not implemented yet. Keep both switches off.
LIVE_TRADING_ENABLED=false
AUTOMATIC_LIVE_TRADING_ENABLED=false
